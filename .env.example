# Copy to .env to change anything. All values are optional.

# Must be the same for all APIs (compose passes it to each one)
JWT_SECRET=dev-secret-change-me
ADMIN_EMAIL=admin@shoplite.local
ADMIN_PASSWORD=Admin123!

# Where the other repos are checked out (relative to this folder)
UI_PATH=../r1
ORDERS_API_PATH=../r2
CATALOG_API_PATH=../r3
JOBS_PATH=../r4
USERS_API_PATH=../r6

# Host ports
UI_PORT=8080
USERS_API_PORT=3001
ORDERS_API_PORT=3002
CATALOG_API_PORT=3003
JOBS_HEALTH_PORT=3004
POSTGRES_PORT=5432
MONGO_PORT=27017
KAFKA_PORT=9094

# Jobs worker behaviour
PROCESSING_DELAY_MS=1500
SUMMARY_INTERVAL_MS=10000
